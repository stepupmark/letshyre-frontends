VITE_API_BASE_URL=

# Canonical/OG domain baked into prerendered pages and the sitemap. Defaults
# to the production domain when unset — set explicitly per environment.
VITE_SITE_URL=

# Required: production, staging or development. Only production gets the
# indexable robots.txt and the Meta Pixel. The build fails if it's unset.
VITE_ENV=development

# Meta Pixel ID. Required when VITE_ENV=production.
VITE_META_PIXEL_ID=1060103123517538
