# Store and check out text as LF on every OS. Git for Windows ships with
# core.autocrlf=true, which would otherwise rewrite files to CRLF on checkout.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.pdf binary
