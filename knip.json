{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tooling/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts"]
    },
    "packages/eslint-config": {
      "entry": ["src/*.js", "test/*.test.js"],
      "ignoreDependencies": ["eslint-import-resolver-typescript", "valibot"]
    },
    "apps/marketing": {
      "entry": ["test/setup.ts", "lighthouserc.cjs"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/app": {
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/admin": {
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/i18n": {
      "entry": ["test/**/*.test.{ts,tsx}"]
    },
    "packages/api": {
      "entry": ["test/**/*.test.ts"]
    },
    "packages/analytics": {
      "entry": ["test/**/*.test.{ts,tsx}"]
    },
    "packages/blocks": {
      "entry": ["test/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/auth": {
      "entry": ["test/**/*.test.ts"]
    }
  }
}
