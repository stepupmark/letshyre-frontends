{
  "name": "letshyre",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui:drift": "node tooling/ui-drift.ts",
    "i18n:apply": "node tooling/i18n/apply.ts",
    "i18n:apply:app": "node tooling/i18n/apply.ts --app",
    "verify": "turbo run lint typecheck build && turbo run test --concurrency=1 && pnpm ui:drift && pnpm knip && turbo run test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5"
  }
}
