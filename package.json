{
  "name": "letshyre",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "react-router dev",
    "dev:pseudo": "react-router dev --mode pseudo",
    "build": "node scripts/check-production-env.mjs && react-router build && node scripts/preload-catalogs.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-robots.mjs && node scripts/verify-seo.mjs",
    "build:ci": "node scripts/check-production-env.mjs && node scripts/check-i18n-parity.mjs && node scripts/check-i18n-quality.mjs && node scripts/check-i18n-usage.mjs && node scripts/check-i18n-review.mjs && node scripts/check-i18n-routes.mjs && node scripts/build-with-retry.mjs && node scripts/check-i18n-budget.mjs && node scripts/check-bundle-budget.mjs && node scripts/check-a11y.mjs && node scripts/check-rtl-classes.mjs && node scripts/check-naming.mjs && node scripts/check-feature-boundaries.mjs && node scripts/check-shared-layer.mjs && node scripts/preload-catalogs.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-robots.mjs && node scripts/verify-seo.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:bundle": "node scripts/check-bundle-budget.mjs",
    "verify:a11y": "node scripts/check-a11y.mjs",
    "verify:naming": "node scripts/check-naming.mjs",
    "verify:boundaries": "node scripts/check-feature-boundaries.mjs",
    "verify:shared-layer": "node scripts/check-shared-layer.mjs",
    "verify:i18n-parity": "node scripts/check-i18n-parity.mjs",
    "verify:i18n-quality": "node scripts/check-i18n-quality.mjs",
    "verify:i18n-usage": "node scripts/check-i18n-usage.mjs",
    "verify:i18n-review": "node scripts/check-i18n-review.mjs",
    "verify:i18n-routes": "node scripts/check-i18n-routes.mjs",
    "i18n:review": "node scripts/check-i18n-review.mjs --record",
    "i18n:glossary": "node scripts/i18n-glossary-report.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "typegen": "react-router typegen",
    "preview": "vite preview",
    "verify:live": "node scripts/verify-live.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "optimize:images": "node scripts/optimize-images.mjs",
    "new:feature": "node scripts/new-feature.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "i18next": "^26.4.2",
    "isbot": "^5.2.2",
    "lucide-react": "^1.42.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "react-joyride": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "8.3.1",
    "@react-router/fs-routes": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
